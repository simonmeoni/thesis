@article{pellicer-sanchez_incidental_2016,
	title = {Incidental {L2} {Vocabulary} {Acquisition} {From} and {While} {Reading}.},
	volume = {38},
	issn = {02722631},
	url = {http://10.0.3.249/S0272263115000224%0Ahttp://proxy.libraries.smu.edu/login?url=http://search.ebscohost.com/login.aspx?direct=true&db=cms&AN=113550989&site=ehost-live&scope=site%0Ahttp://proxy.libraries.smu.edu/login?url=http://search.ebscohost.com/login.a},
	abstract = {Previous studies have shown that reading is an important source of incidental second language (L2) vocabulary acquisition. However, we still do not have a clear picture of what happens when readers encounter unknown words. Combining offline (vocabulary tests) and online (eye-tracking) measures, the incidental acquisition of vocabulary knowledge from reading and the online reading of unknown lexical items were examined. L2 English learners read a story containing unknown items while their eye movements were recorded. After eight exposures, L2 readers recognized the form and the meaning of 86\% and 75\% of the target nonwords, respectively, whereas they recalled the meaning of 55\% of the nonwords. After three to four encounters, nonwords were read significantly faster, and by eight encounters they were read in a similar manner to previously known real words. Results also showed a positive relationship between new vocabulary learning outcomes and online reading, with longer reading times associated with higher vocabulary recall test scores. The study was also conducted with first language (L1) readers to provide baseline data for comparison. Results confirmed the L2 findings while also indicating an interesting L1-L2 distinction in the rate rather than in the ultimate outcome of the acquisition process. [ABSTRACT FROM AUTHOR]},
	number = {1},
	journal = {Studies in Second Language Acquisition},
	author = {Pellicer-Sánchez, Ana1},
	year = {2016},
	keywords = {Eye movements, Online reading programs, Recollection (Psychology), Second language acquisition, Vocabulary tests, annotation},
	pages = {97--130},
}

