@article{zhouDataSifterTextPartiallySynthetic2022,
	title        = {{{DataSifterText}}: {{Partially Synthetic Text Generation}} for {{Sensitive Clinical Notes}}},
	shorttitle   = {{DataSifterText}},
	author       = {Zhou, Nina and Wu, Qiucheng and Wu, Zewen and Marino, Simeone and Dinov, Ivo D.},
	year         = 2022,
