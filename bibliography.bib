@misc{hongORPOMonolithicPreference2024,
	title        = {{{ORPO}}: {{Monolithic Preference Optimization}} without {{Reference Model}}},
	shorttitle   = {{ORPO}},
	author       = {Hong, Jiwoo and Lee, Noah and Thorne, James},
	year         = 2024,
	month        = mar,
