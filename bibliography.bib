@misc{thiagarajanUnderstandingBehaviorClinical2019,
	title        = {Understanding {{Behavior}} of {{Clinical Models}} under {{Domain Shifts}}},
	author       = {Thiagarajan, Jayaraman J. and Rajan, Deepta and Sattigeri, Prasanna},
